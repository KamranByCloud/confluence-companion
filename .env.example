# Copy to .env and fill in. .env is gitignored and must stay mode 600.
# Use a NORMAL Atlassian API token (not a scoped one) against the site URL.
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# GitHub account used for this repository (gh CLI + git remote).
# Not consumed by the MCP server, documented here for local setup parity.
GITHUB_ACCOUNT=
GITHUB_REPO=
