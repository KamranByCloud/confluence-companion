# Reference for the environment variables the server reads. It does NOT read a
# .env from the checkout; that source was removed when the server became an
# installed single file.
#
# Normally you do not need this file at all: run 'confluence-companion init',
# which stores the credentials in ~/.config/confluence-companion/config.env at
# mode 600. Set these variables instead when there should be no file at all,
# which is the usual arrangement in a dev container or in CI.
#
# Use a NORMAL Atlassian API token (not a scoped one) against the site URL.
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# GitHub account used for this repository (gh CLI + git remote).
# Not consumed by the MCP server, documented here for local setup parity.
GITHUB_ACCOUNT=
GITHUB_REPO=
